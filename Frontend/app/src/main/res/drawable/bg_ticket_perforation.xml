<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical">
        <shape android:shape="line"><stroke android:width="1dp" android:color="@color/outline" android:dashWidth="4dp" android:dashGap="4dp" /></shape>
    </item>
    <item android:width="16dp" android:height="16dp" android:gravity="center_vertical|left" android:left="-8dp">
        <shape android:shape="oval"><solid android:color="@color/background" /></shape>
    </item>
    <item android:width="16dp" android:height="16dp" android:gravity="center_vertical|right" android:right="-8dp">
        <shape android:shape="oval"><solid android:color="@color/background" /></shape>
    </item>
</layer-list>
