<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_vertical">

        <!-- 顶部步骤导航 -->
        <LinearLayout
            android:id="@+id/topNavigationBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/composer_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="@dimen/navigation_button_width"
                android:layout_height="match_parent"
                android:contentDescription="@string/navigation_back"
                android:enabled="false"
                android:gravity="center"
                android:insetLeft="@dimen/space_xs"
                android:insetTop="@dimen/navigation_button_vertical_inset"
                android:insetRight="@dimen/space_xs"
                android:insetBottom="@dimen/navigation_button_vertical_inset"
                android:minWidth="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/navigation_back_background"
                app:cornerRadius="@dimen/navigation_button_radius"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/navigation_next_content"
                tools:enabled="true" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/stepText"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:background="@drawable/bg_step_indicator"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="64dp"
                android:paddingHorizontal="@dimen/space_md"
                android:textAlignment="center"
                android:textColor="@color/step_indicator_text"
                android:textSize="@dimen/text_body"
                tools:text="01 / 05" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="@dimen/navigation_button_width"
                android:layout_height="match_parent"
                android:contentDescription="@string/navigation_next"
                android:enabled="false"
                android:gravity="center"
                android:insetLeft="@dimen/space_xs"
                android:insetTop="@dimen/navigation_button_vertical_inset"
                android:insetRight="@dimen/space_xs"
                android:insetBottom="@dimen/navigation_button_vertical_inset"
                android:minWidth="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/navigation_next_background"
                app:cornerRadius="@dimen/navigation_button_radius"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/navigation_next_content"
                tools:enabled="true" />

        </LinearLayout>

        <!-- 五段进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/progressStep1"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@color/lime" />

            <View
                android:id="@+id/progressStep2"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@color/outline" />

            <View
                android:id="@+id/progressStep3"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@color/outline" />

            <View
                android:id="@+id/progressStep4"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@color/outline" />

            <View
                android:id="@+id/progressStep5"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_xs"
                android:layout_weight="1"
                android:background="@color/outline" />


        </LinearLayout>

        <!-- 选择目的地后显示的实时旅行板 -->
        <LinearLayout
            android:id="@+id/tripBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_trip_board"
            android:importantForAccessibility="yes"
            android:orientation="vertical"
            android:padding="@dimen/space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/live_trip_label"
                android:textColor="@color/on_trip_board"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tripBoardDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:includeFontPadding="false"
                android:textColor="@color/on_trip_board"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:text="Kyoto" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:includeFontPadding="false"
                android:text="@string/live_trip_status"
                android:textColor="@color/on_trip_board"
                android:textSize="@dimen/text_label" />

        </LinearLayout>

        <!-- 主标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:includeFontPadding="false"
            android:text="@string/plan_headline"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <!-- AI 对话气泡 -->
        <LinearLayout
            android:id="@+id/assistantBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_chat_bubble"
            android:orientation="vertical"
            android:padding="@dimen/space_lg"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/assistant_destination_title"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:includeFontPadding="false"
                android:text="@string/assistant_destination_message"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/text_label" />

        </LinearLayout>

        <!-- 按钮引导区 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/travelStyleChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:chipSpacingVertical="@dimen/space_sm"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/cityWalkChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/style_city_walk"
                android:textColor="@color/chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background"
                app:chipCornerRadius="@dimen/radius_chip"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_width" />

            <com.google.android.material.chip.Chip
                android:id="@+id/natureRetreatChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/style_nature_retreat"
                android:textColor="@color/chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background"
                app:chipCornerRadius="@dimen/radius_chip"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_width" />

            <com.google.android.material.chip.Chip
                android:id="@+id/foodFirstChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/style_food_first"
                android:textColor="@color/chip_text"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_background"
                app:chipCornerRadius="@dimen/radius_chip"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_width" />

        </com.google.android.material.chip.ChipGroup>

        <!-- 推荐目的地 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:includeFontPadding="false"
            android:text="@string/recommended_destinations"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/kyotoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_target_min"
                app:cardBackgroundColor="@color/lime"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:rippleColor="@color/outline"
                app:strokeColor="@color/text_primary"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/destination_kyoto"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:includeFontPadding="false"
                        android:text="@string/destination_kyoto_description"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_label" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tokyoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_target_min"
                app:cardBackgroundColor="@color/mint"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:rippleColor="@color/outline"
                app:strokeColor="@color/outline"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/destination_tokyo"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:includeFontPadding="false"
                        android:text="@string/destination_tokyo_description"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_label" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_xl" />



        <!-- 底部 AI 输入框 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/composerContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/composer_height"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/composer_background"
            app:cardCornerRadius="@dimen/radius_small"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/composer_hint"
                    android:imeOptions="actionSend"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="0dp"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textColor="@color/composer_on_background"
                    android:textColorHint="@color/composer_hint"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendButton"
                    android:layout_width="@dimen/composer_height"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/send_message"
                    android:insetLeft="@dimen/space_xs"
                    android:insetTop="@dimen/space_xs"
                    android:insetRight="@dimen/space_xs"
                    android:insetBottom="@dimen/space_xs"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/composer_action"
                    app:cornerRadius="@dimen/radius_send_button"
                    app:icon="@drawable/ic_arrow_upward"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/on_accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
