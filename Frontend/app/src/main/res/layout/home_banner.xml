<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createTripBanner" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:clickable="true" android:focusable="true" android:contentDescription="@string/create_my_trip"
    app:cardCornerRadius="@dimen/radius_large" app:cardBackgroundColor="@color/lime"
    app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_xl"
        android:importantForAccessibility="noHideDescendants">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/editorial_banner_kicker" android:textSize="10sp"
            android:letterSpacing="0.12" android:textStyle="bold" android:textColor="@color/on_accent" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:text="@string/editorial_banner_title"
            android:letterSpacing="-0.04" android:includeFontPadding="false"
            android:textSize="32sp" android:textStyle="bold" android:textColor="@color/on_accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl" android:background="@drawable/bg_home_banner_action"
            android:paddingHorizontal="@dimen/space_lg" android:paddingVertical="@dimen/space_md"
            android:text="@string/editorial_create" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/lime" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
