<resources>

    <style name="Base.Theme.Odyssey"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 主要品牌色 -->
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">@color/on_accent</item>

        <!-- 次要品牌色 -->
        <item name="colorSecondary">@color/red</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <!-- 第三强调色 -->
        <item name="colorTertiary">@color/purple</item>
        <item name="colorOnTertiary">@color/on_accent</item>

        <!-- 页面与卡片 -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Odyssey.Dialog</item>

        <!-- 系统状态栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <!-- 主题 colorPrimary 是荧光绿，对话框文字按钮在白底上看不见，这里单独改深色。 -->
    <style name="ThemeOverlay.Odyssey.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
    </style>

    <style name="Theme.Odyssey" parent="Base.Theme.Odyssey">
        <!-- 放在这里而不是 Base，浅色和深色主题共用同一份字体配置 -->
        <!-- 不要同时设 app 命名空间的 fontFamily：AppCompat 优先读它，会盖掉布局里的 android:fontFamily -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Odyssey.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Odyssey.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Odyssey.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Odyssey.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Odyssey.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Odyssey.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Odyssey.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Odyssey.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Odyssey.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Odyssey.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Odyssey.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Odyssey.LabelSmall</item>
    </style>

</resources>