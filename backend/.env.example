# Copy to .env and fill in. Never commit .env.

# PostgreSQL (kept as separate fields so special characters in the password need no URL-escaping)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=odyssey
DB_PASSWORD=change-me
DB_NAME=odyssey
DB_SCHEMA=odyssey

# LLM (provider-neutral; any OpenAI-compatible endpoint works via LLM_BASE_URL)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
