# Copy to .env and fill in. Never commit .env.

# PostgreSQL (kept as separate fields so special characters in the password need no URL-escaping)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=odyssey
DB_PASSWORD=change-me
DB_NAME=odyssey
DB_SCHEMA=odyssey

# LLM. LLM_PROVIDER: "openai" (any OpenAI-compatible server: OpenAI, vLLM, Ollama, LM Studio...
# via LLM_BASE_URL) or "anthropic" (needs `uv sync --extra anthropic`).
# Local server example: LLM_PROVIDER=openai, LLM_BASE_URL=http://localhost:11434/v1,
# LLM_MODEL=qwen2.5:14b. LLM_API_KEY may stay empty for local servers.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120

# Google Map Grounding Lite
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MCP_URL=https://mapstools.googleapis.com/mcp

# Flight search MCP server (no key needed)
KIWI_MCP_URL=https://mcp.kiwi.com

# Accommodation search MCP server (no key needed)
TRIVAGO_MCP_URL=https://mcp.trivago.com/mcp

# Maximum duration of one synchronous research request, in seconds
RESEARCH_TIMEOUT_S=600
